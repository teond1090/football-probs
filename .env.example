# Copy to .env and fill in. Both keys are free.

# Live sportsbook lines: https://the-odds-api.com  (free tier = 500 requests/month)
ODDS_API_KEY=

# College schedules/scores/lines: https://collegefootballdata.com/key
CFBD_API_KEY=

# Minutes to reuse live odds before spending another API request
ODDS_CACHE_MINUTES=15
